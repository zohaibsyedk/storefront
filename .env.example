# Copy to apps/web/.env.local. Everything is optional: with nothing set, the app runs fully on mocks.

# Model for copy, change requests and chat. Without it, deterministic copy is used.
ANTHROPIC_API_KEY=
# Or use your logged-in Claude Code CLI instead of an API key:
# STOREFRONT_LLM=claude-cli

# Chain for new businesses: mock (default), localnet (run `npm run chain:local`), or devnet.
# STOREFRONT_CHAIN=localnet

# Where business data and keys are stored (default: <repo>/.data)
# STOREFRONT_DATA_DIR=
