{
  "name": "storefront",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w web",
    "lint": "npm run lint -w web",
    "test": "vitest run",
    "demo": "tsx scripts/demo.mts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22",
    "fast-check": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
